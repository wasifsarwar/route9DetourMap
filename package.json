    "refresh:data": "tsx src/data/refresh.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "gtfs-realtime-bindings": "^2.2.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
